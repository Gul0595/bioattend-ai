# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=BioAttend Ultimate
APP_ENV=production
DEBUG=True
SECRET_KEY=supersecurekey123456789

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/bioattend

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Storage: local | s3 | minio ───────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage

# AWS S3 (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=bioattend-images

# MinIO self-hosted (if STORAGE_BACKEND=minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bioattend-images

# ── Face Recognition ──────────────────────────────────────────────────────────
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
FACE_DISTANCE_THRESHOLD=0.40
FACE_MIN_CONFIDENCE=0.90
MAX_FACE_IMAGE_SIZE_MB=5

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@bioattend.app

# ── Frontend URL (for password reset links) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173
